# Copy to .env and adjust. Never commit .env or real keys.

APP_ENV=development
# SQLite file, created automatically on first start (relative paths are relative to the project root)
DATABASE_URL=sqlite:///./data/api_dashboard.db
DATA_DIR=data
REPORTS_DIR=reports

# --- Dashboard login ---------------------------------------------------------
ADMIN_USERNAME=admin
# Blank: a random password is generated on first start and printed once.
# Set a value (min 12 chars recommended) to choose your own.
ADMIN_PASSWORD=
# Blank: generated once and stored in data/.secret_key. Used to sign sessions and
# encrypt saved credentials. Changing it invalidates sessions and saved secrets.
SECRET_KEY=
SESSION_HOURS=8
# Set true when serving over HTTPS
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# --- Demo API (default test target) -----------------------------------------
ENABLE_DEMO_API=true
# Not a secret: only guards the fake /demo/protected endpoint used by tests
DEMO_API_TOKEN=demo-token-local
# Optional: override the URL the bundled suites test (default: this server)
TEST_TARGET_URL=

# --- Outbound target policy (SSRF protection) -------------------------------
ALLOW_LOCAL_TARGETS=true
ALLOW_PRIVATE_NETWORK_TARGETS=false
# Unsafe by default. If enabled, each request/run also needs the explicit
# "I am authorised" confirmation, and the host must be in the allowlist (if set).
ALLOW_EXTERNAL_TARGETS=false
EXTERNAL_TARGET_ALLOWLIST=api.example.com,staging.example.com

# --- Test execution ----------------------------------------------------------
MAX_CONCURRENT_RUNS=1
MAX_ACTIVE_RUNS=5
TEST_TIMEOUT_SECONDS=180
TEST_RETRY_COUNT=2

# --- Performance testing -----------------------------------------------------
PERF_TESTING_ENABLED=true
PERF_MAX_REQUESTS=500
PERF_MAX_CONCURRENCY=20
PERF_MAX_DURATION_SECONDS=60

# --- Optional AI (rules-based fallback when blank/none) ---------------------
# AI_PROVIDER: none | openai_compatible (OpenAI, Azure-compatible gateways, Ollama, LM Studio ...)
AI_PROVIDER=none
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
